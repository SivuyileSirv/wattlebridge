{
  "name": "wattlebridge",
  "version": "1.0.0",
  "private": true,
  "description": "Custom WordPress theme for Wattlebridge Technical Recruitment",
  "scripts": {
    "css:compile": "sass assets/scss/main.scss assets/dist/main.css --style=expanded --no-source-map",
    "css:prefix": "postcss assets/dist/main.css --replace",
    "build": "npm run css:compile && npm run css:prefix",
    "watch:css": "chokidar \"assets/scss/**/*.scss\" -c \"npm run build\"",
    "watch:browser": "browser-sync start --proxy http://localhost:56946 --files \"assets/dist/*.css,assets/js/**/*.js,**/*.php\" --port 3000 --no-open --no-notify",
    "dev": "concurrently --kill-others-on-fail -n CSS,BROWSER \"npm:watch:css\" \"npm:watch:browser\""
  },
  "engines": {
    "node": ">=24"
  },
  "browserslist": [
    "defaults",
    "not dead"
  ],
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "browser-sync": "^3.0.4",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "sass": "^1.107.1"
  }
}
